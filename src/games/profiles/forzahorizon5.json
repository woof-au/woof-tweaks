      "win-visual-fx",
      "win-transparency-off",
      "win-background-apps-off",
      "win-max-refresh",
      "win-ads-off",
      "win-sticky-keys-off",
      "win-hibernate-off",
      "win-tdr-delay",
      "win-fth-off",
      "win-pcie-aspm-off",
      "win-sysmain-off",
      "win-compat-telemetry-off",
      "win-update-no-restart",
      "win-hags-on"
    ],
    "linux": [
      "linux-governor-performance",
      "linux-epp-performance",
      "linux-turbo-on",
      "linux-power-profile",
      "linux-gamemode",
      "linux-max-map-count",
      "linux-split-lock-off",
