{
  "id": "seaofthieves",
  "name": "Sea of Thieves",
  "short": "Sea of Thieves",
  "genre": "Adventure",
  "colors": [
    "#1d8a99",
    "#0b1d26"
  ],
  "competitive": false,
  "antiCheat": "Easy Anti-Cheat",
  "platforms": [
    "win32",
    "linux"
  ],
  "detect": {
    "steam": 1172620,
    "process": [
      "SoTGame.exe"
    ],
    "exe": [
      "SoTGame.exe"
    ]
  },
  "tweaks": {
    "win32": [
      "win-plan-woof",
      "win-game-mode",
      "win-game-dvr-off",
      "win-game-bar-off",
      "win-fso-off",
      "win-visual-fx",
      "win-transparency-off",
      "win-background-apps-off",
      "win-max-refresh",
      "win-ads-off",
      "win-sticky-keys-off",
      "win-hibernate-off",
      "win-tdr-delay",
      "win-fth-off",
      "win-pcie-aspm-off",
      "win-sysmain-off",
      "win-compat-telemetry-off",
      "win-update-no-restart",
      "win-hags-on"
    ],
    "linux": [
      "linux-governor-performance",
      "linux-epp-performance",
      "linux-turbo-on",
      "linux-power-profile",
      "linux-gamemode",
      "linux-max-map-count",
      "linux-split-lock-off",
      "linux-swappiness",
      "linux-io-nvme-none",
      "linux-mesa-cache-size",
      "linux-nvidia-powermizer",
      "linux-file-limits"
    ]
  },
  "extras": [
    "fso",
    "gpuPreference",
    "priority",
    "shaderCache",
    "defender"
  ],
  "launchOptions": {
    "linux": "gamemoderun %command%"
  },
  "settings": [
    {
      "setting": "Display mode",
      "value": "Fullscreen",
      "why": "Lowest input lag and best frame pacing."
    },
    {
      "setting": "Quality preset",
      "value": "Rare or Legendary",
      "why": "Mythical costs a lot of FPS for small visual gains."
    },
    {
      "setting": "VSync",
      "value": "Off",
      "why": "Lower input lag."
    }
  ],
  "regions": [
    "us-east-1",
    "us-west-2",
    "sa-east-1",
    "eu-west-1",
    "eu-central-1",
    "ap-southeast-1",
